{
  "name": "weblist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "playlist:clean": "node server/scripts/cleanPlaylist.js",
    "seed": "node server/scripts/seed.js",
    "start": "node server/index.js",
    "cap:add:android": "cap add android",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.8.0",
    "hls.js": "^1.6.7",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.542.0",
    "mpegts.js": "^1.8.0",
    "multer": "^2.0.2",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "tailwindcss": "^3.4.17"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "typescript": "^6.0.3"
  }
}
