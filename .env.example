JWT_SECRET=troque-por-um-segredo-grande
JWT_EXPIRES_IN=30d
LOCAL_MODE=false
ALLOWED_ORIGINS=http://localhost:3333,http://localhost:5173
WEBLIST_STRICT_PRODUCTION=true
IMAGE_UPLOAD_MAX_BYTES=8388608
LOGIN_BACKGROUND_FETCH_TIMEOUT_MS=20000

# Use uma das duas credenciais do TMDB.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_LANGUAGE=pt-BR
OMDB_API_KEY=

# Atualizacao automatica de capas/sinopses.
AUTO_TMDB_ENABLED=true
AUTO_TMDB_RUN_ON_START=true
AUTO_TMDB_START_DELAY_SECONDS=45
AUTO_TMDB_INTERVAL_MINUTES=360
AUTO_TMDB_BATCH_SIZE=1000
AUTO_TMDB_RUN_ALL=true
AUTO_TMDB_FORCE=false
AUTO_TMDB_DELAY_MS=160
AUTO_TMDB_RETRY_DAYS=14
METADATA_FETCH_TIMEOUT_MS=25000
TMDB_PROGRESS_LOG_EVERY=100
